{
  "name": "meteolab",
  "private": true,
  "version": "2.10.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:slow": "vitest run --mode slow src/core/calibration.test.ts",
    "test:reference": "vitest run --mode slow src/core/reference.test.ts",
    "test:scenarios": "vitest run --mode slow src/core/scenarios.test.ts",
    "test:diurnal": "vitest run --mode slow src/core/diurnal.test.ts",
    "bench": "vite build --ssr tests/bench/threads.ts --outDir .bench --emptyOutDir --logLevel warn && node .bench/threads.js",
    "series": "vite build --ssr tools/series.ts --outDir .series --emptyOutDir --logLevel warn && node .series/series.js",
    "validate": "vite build --ssr tools/validate.ts --outDir .validate --emptyOutDir --logLevel warn && node .validate/validate.js"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/onest": "^5.3.1",
    "@types/three": "^0.185.1",
    "three": "^0.185.1"
  }
}
